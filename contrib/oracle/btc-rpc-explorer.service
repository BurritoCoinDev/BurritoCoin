# BurritoCoin block explorer (btc-rpc-explorer) — Oracle A1.
# Listens on 127.0.0.1:3002; nginx terminates :80/:443 in front of it.
# Config (including the node RPC password) lives in
# /opt/btc-rpc-explorer/.env — chmod 600, never commit it.
#
# sudo cp btc-rpc-explorer.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now btc-rpc-explorer
[Unit]
Description=BurritoCoin block explorer (btc-rpc-explorer)
After=network-online.target burritocoind.service
Wants=burritocoind.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/btc-rpc-explorer
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node bin/www
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
